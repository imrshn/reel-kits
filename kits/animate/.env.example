# Optional: use your own cloned voice instead of the free one.
# Copy this file to .env, fill in ONE service, and set "voice_engine" in settings.json.
# Never share your .env file.

# Fish Audio (fish.audio > API keys; voice id = the model id of your voice)
FISH_API_KEY=
FISH_VOICE_ID=

# ElevenLabs (elevenlabs.io > Developers > API keys; voice id from the Voices page)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
